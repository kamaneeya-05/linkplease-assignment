# Backend Configuration
DATABASE_URL=postgresql://linkplease:linkplease@postgres:5432/linkplease
PSEUDOGRAM_API_KEY=your-pseudogram-api-key-here
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com
WEBHOOK_SECRET=your-webhook-secret-here

# Environment
ENVIRONMENT=development
DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_SECONDS=60

# Retry Configuration
MAX_DELIVERY_ATTEMPTS=5
INITIAL_RETRY_DELAY_SECONDS=5
MAX_RETRY_DELAY_SECONDS=300
RETRY_BACKOFF_MULTIPLIER=2

# Reconciliation
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_SECONDS=30
RECONCILIATION_MAX_BATCH_SIZE=10

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Webhook Signature Verification
VERIFY_WEBHOOK_SIGNATURE=false
